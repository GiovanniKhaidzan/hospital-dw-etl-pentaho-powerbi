    <connection>conn_oltp</connection>
    <sql>SELECT 
    l.id_lab, 
    l.id_kunjungan, 
    l.jenis_pemeriksaan, 
    l.nama_parameter, 
    l.nilai_hasil, 
    l.status_hasil, 
    l.tanggal_periksa, 
    k.no_rekam_medis, 
    k.id_poli, 
    k.id_dokter
FROM t_hasil_lab l
JOIN t_kunjungan_pasien k ON l.id_kunjungan = k.id_kunjungan</sql>
    <limit>0</limit>
    <lookup/>
